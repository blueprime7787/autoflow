{
  "name": "autoflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "api": "wrangler dev --port 8787 --persist-to .wrangler/demo",
    "db:init": "wrangler d1 migrations apply DB --local --persist-to .wrangler/demo",
    "test": "node --test tests/*.test.mjs",
    "preview": "wrangler dev --port 8787",
    "deploy:prepare": "npm run build && wrangler deploy --dry-run",
    "test:integration": "node tests/integration.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}